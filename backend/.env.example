# App
APP_NAME="Abdul Ghaffar Meat Shop API"
DEBUG=true
SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agms
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/agms

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Firebase
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=your-key
CLOUDINARY_API_SECRET=your-secret

# SMS Provider (Twilio) — optional, Telegram is the OTP channel
TWILIO_ACCOUNT_SID=your-sid
TWILIO_AUTH_TOKEN=your-token
TWILIO_PHONE_NUMBER=+1234567890

# Telegram Bot (OTP delivery)
TELEGRAM_BOT_TOKEN=your-bot-token

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_AUTH_PER_MINUTE=5

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
